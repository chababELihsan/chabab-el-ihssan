{
  "name": "chabab-el-ihssan",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "keep_vars": true,
  "vars": {
    "GITHUB_CLIENT_ID": "الصق_هنا_الـ_Client_ID"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/oauth/*"]
  }
}
